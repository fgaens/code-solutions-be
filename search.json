---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "tags": {{ post.tags | join: ', ' | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | prepend: site.url | jsonify }},
      "date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
      "description": {{ post.description | strip_html | normalize_whitespace | jsonify }},
      "content": {{ post.content | strip_html | normalize_whitespace | truncate: 300 | jsonify }},
      {% assign image_url = post.post-image %}
      {% assign image_start = image_url | slice: 0, 1 %}
      {% assign image_prefix = image_url | slice: 0, 2 %}
      {% if image_start == '/' and image_prefix != '//' %}
      {% assign root_url = site.baseurl_root %}
      {% if root_url == nil %}{% assign root_url = site.baseurl %}{% endif %}
      {% assign image_url = root_url | append: image_url %}
      {% endif %}
      "image": {{ image_url | jsonify }},
      "readtime": {{ post.content | number_of_words | divided_by: 180 | at_least: 1 | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
